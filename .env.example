# ── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Gemini AI ────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Resend (email) ────────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx
REPORT_FROM_EMAIL=reports@yourdomain.com
REPORT_TO_EMAIL=meera@example.com
REPORT_CC_EMAIL=ca-friend@example.com   # optional

# ── App URL (used in email links) ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# ── Security ──────────────────────────────────────────────────────────────────
# Optional: protects fund add/remove form. Leave blank to disable.
ADMIN_PASSPHRASE=choose_something_strong

# ── Vercel cron auth (auto-set by Vercel, leave blank locally) ───────────────
CRON_SECRET=
